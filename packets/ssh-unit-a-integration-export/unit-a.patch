+    #[tokio::test]
+    async fn reaped_group_leader_does_not_prove_its_live_helper_was_cleaned_up() {
+        use tokio::io::AsyncBufReadExt;
+        struct Helper(crate::owned_process::ProcessIdentity);
+        impl Drop for Helper {
+            fn drop(&mut self) {
+                let _ = crate::owned_process::send(
+                    self.0,
+                    crate::owned_process::Target::Process,
+                    crate::owned_process::Signal::Kill,
+                );
+            }
+        }
+        let mut command = Command::new("sh");
+        command
+            .args(["-c", "sleep 30 & echo $!; read line; exit 0"])
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .kill_on_drop(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::process::CommandExt;
+            command.as_std_mut().process_group(0);
+        }
+        let mut child = command.spawn().expect("owned group leader");
+        let mut group = ProcessGroup::new(&child);
+        let mut reader =
+            tokio::io::BufReader::new(child.stdout.take().expect("helper identity pipe"));
+        let mut line = String::new();
+        reader.read_line(&mut line).await.expect("helper PID");
+        let helper = Helper(
+            crate::owned_process::identify(line.trim().parse().expect("pid"))
+                .expect("captured live helper"),
+        );
+        drop(child.stdin.take());
+        child.wait().await.expect("leader reaped");
+        assert_eq!(
+            group.signal(),
+            GroupSignal::NotOwned,
+            "gone leader no longer grants group signal authority"
+        );
+        assert!(
+            crate::owned_process::is_alive(helper.0),
+            "helper remains alive after leader reap"
+        );
+        let local = LocalCleanup {
+            leader_reaped: true,
+            group_signals: vec![GroupSignal::NotOwned],
+            helpers: Helpers::Unconfirmed,
+        };
+        assert_eq!(local.helpers, Helpers::Unconfirmed);
+    }
