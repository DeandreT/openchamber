+//! Private observations from best-effort SSH cleanup, separate from completion.
+
+use crate::owned_process::SignalError;
+
+pub(crate) type CleanupReceipt = tokio::sync::watch::Receiver<Option<CleanupReport>>;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum RemoteStop {
+    NotRequested,
+    Stopped,
+    Failed,
+    Absent,
+    Uncertain,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum GroupSignal {
+    Sent,
+    IdentityUnavailable,
+    NotOwned,
+    Unavailable,
+    Refused,
+}
+
+impl GroupSignal {
+    pub(crate) fn observed(result: Result<(), SignalError>) -> Self {
+        match result {
+            Ok(()) => Self::Sent,
+            Err(SignalError::NotOwned) => Self::NotOwned,
+            Err(SignalError::Unavailable) => Self::Unavailable,
+            Err(SignalError::Refused) => Self::Refused,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Helpers {
+    /// Neither a signal request nor reaping the leader confirms all helpers.
+    Unconfirmed,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct LocalCleanup {
+    pub(crate) leader_reaped: bool,
+    pub(crate) group_signals: Vec<GroupSignal>,
+    pub(crate) helpers: Helpers,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct CleanupReport {
+    pub(crate) remote: RemoteStop,
+    pub(crate) local: LocalCleanup,
+}
+
+pub(crate) enum TargetState {
+    Matching,
+    Absent,
+    Uncertain,
+}
+
+/// The existing CLI status provides PID, runtime and launch mode, not an atomic
+/// conditional-stop capability. Missing or changed identity grants no stop.
+pub(crate) fn target_state(text: &str, port: u16, expected_pid: Option<u32>) -> TargetState {
+    let Some(pid) = expected_pid else {
+        return TargetState::Uncertain;
+    };
+    let Ok(value) = serde_json::from_str::<serde_json::Value>(text.trim()) else {
+        return TargetState::Uncertain;
+    };
+    let Some(instances) = value.get("instances").and_then(|value| value.as_array()) else {
+        return TargetState::Uncertain;
+    };
+    // A record with an unreadable port could be the target. It cannot prove
+    // absence, while unrelated records with valid ports stay independent.
+    if instances.iter().any(|entry| {
+        entry
+            .get("port")
+            .and_then(|value| value.as_u64())
+            .is_none_or(|port| port == 0 || port > u64::from(u16::MAX))
+    }) {
+        return TargetState::Uncertain;
+    }
+    let mut matches = instances.iter().filter(|entry| {
+        entry.get("port").and_then(|value| value.as_u64()) == Some(u64::from(port))
+    });
+    let Some(entry) = matches.next() else {
+        return TargetState::Absent;
+    };
+    if matches.next().is_some()
+        || entry.get("pid").and_then(|value| value.as_u64()) != Some(u64::from(pid))
+        || entry.get("runtime").and_then(|value| value.as_str()) != Some("cli")
+        || entry.get("launchMode").and_then(|value| value.as_str()) != Some("daemon")
+    {
+        return TargetState::Uncertain;
+    }
+    TargetState::Matching
+}
+
+pub(crate) fn stop_reply(text: &str, port: u16, pid: u32) -> RemoteStop {
+    let Ok(value) = serde_json::from_str::<serde_json::Value>(text.trim()) else {
+        return RemoteStop::Uncertain;
+    };
+    let Some(results) = value.get("results").and_then(|value| value.as_array()) else {
+        return RemoteStop::Uncertain;
+    };
+    if results.is_empty() && value.get("stoppedCount").and_then(|value| value.as_u64()) == Some(0) {
+        return if matches!(
+            value.get("status").and_then(|value| value.as_str()),
+            Some("warning" | "error")
+        ) || value
+            .get("messages")
+            .and_then(|value| value.as_array())
+            .is_some_and(|messages| !messages.is_empty())
+        {
+            RemoteStop::Failed
+        } else if value.get("status").is_none()
+            || value.get("status").and_then(|value| value.as_str()) == Some("ok")
+        {
+            RemoteStop::Absent
+        } else {
+            RemoteStop::Uncertain
+        };
+    }
+    let mut matching = results.iter().filter(|entry| {
+        entry.get("port").and_then(|value| value.as_u64()) == Some(u64::from(port))
+    });
+    let Some(entry) = matching.next() else {
+        return RemoteStop::Uncertain;
+    };
+    if matching.next().is_some() {
+        return RemoteStop::Uncertain;
+    }
+    // Explicit-port stop can observe the daemon disappearing after status.
+    // The pinned CLI reports not-found without PID; this grants no new action.
+    if entry.get("reason").and_then(|value| value.as_str()) == Some("not-found") {
+        return if entry.get("stopped").and_then(|value| value.as_bool()) == Some(false)
+            && value.get("stoppedCount").and_then(|value| value.as_u64()) == Some(0)
+        {
+            RemoteStop::Absent
+        } else {
+            RemoteStop::Uncertain
+        };
+    }
+    if entry.get("pid").and_then(|value| value.as_u64()) != Some(u64::from(pid)) {
+        return RemoteStop::Uncertain;
+    }
+    match entry.get("stopped").and_then(|value| value.as_bool()) {
+        Some(true)
+            if value
+                .get("stoppedCount")
+                .and_then(|value| value.as_u64())
+                .is_some_and(|count| count > 0) =>
+        {
+            RemoteStop::Stopped
+        }
+        Some(false) => RemoteStop::Failed,
+        _ => RemoteStop::Uncertain,
+    }
+}
+
+pub(crate) fn launch_reply(text: &str) -> Option<(u16, u32)> {
+    let value: serde_json::Value = serde_json::from_str(text.trim()).ok()?;
+    if value.get("launchMode")?.as_str()? != "daemon" {
+        return None;
+    }
+    let port = u16::try_from(value.get("port")?.as_u64()?)
+        .ok()
+        .filter(|port| *port != 0)?;
+    let pid = u32::try_from(value.get("pid")?.as_u64()?)
+        .ok()
+        .filter(|pid| *pid != 0)?;
+    Some((port, pid))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn zero_exit_warning_is_a_failed_stop_and_unknown_replies_stay_uncertain() {
+        assert_eq!(
+            stop_reply(
+                r#"{"status":"warning","stoppedCount":0,"results":[{"port":42,"pid":7,"stopped":false}]}"#,
+                42,
+                7
+            ),
+            RemoteStop::Failed
+        );
+        for reply in [
+            "",
+            "{broken",
+            "{}",
+            r#"{"status":"unknown","stoppedCount":0,"results":[]}"#,
+            r#"{"stoppedCount":1,"results":[{"port":42,"pid":8,"stopped":true}]}"#,
+        ] {
+            assert_eq!(stop_reply(reply, 42, 7), RemoteStop::Uncertain);
+        }
+        assert_eq!(
+            stop_reply(r#"{"stoppedCount":0,"results":[]}"#, 42, 7),
+            RemoteStop::Absent
+        );
+        assert_eq!(
+            stop_reply(
+                r#"{"status":"ok","stoppedCount":1,"results":[{"port":42,"pid":7,"stopped":true}]}"#,
+                42,
+                7
+            ),
+            RemoteStop::Stopped
+        );
+    }
+
+    #[test]
+    fn missing_or_changed_identity_and_unknown_serve_ack_grant_no_authority() {
+        let current =
+            r#"{"instances":[{"port":42,"pid":8,"runtime":"cli","launchMode":"daemon"}]}"#;
+        assert!(matches!(
+            target_state(current, 42, Some(7)),
+            TargetState::Uncertain
+        ));
+        assert!(matches!(
+            target_state(current, 42, None),
+            TargetState::Uncertain
+        ));
+        assert!(matches!(
+            target_state(current, 42, Some(8)),
+            TargetState::Matching
+        ));
+        assert!(matches!(
+            target_state(r#"{"instances":[]}"#, 42, Some(8)),
+            TargetState::Absent
+        ));
+        assert!(matches!(
+            target_state(r#"{"instances":[{}]}"#, 42, Some(8)),
+            TargetState::Uncertain
+        ));
+        assert_eq!(launch_reply("lost or malformed reply"), None);
+        assert_eq!(launch_reply("23456\n"), None);
+        assert_eq!(
+            launch_reply(r#"{"port":23456,"pid":7,"launchMode":"daemon"}"#),
+            Some((23456, 7))
+        );
+    }
+
+    #[test]
+    fn explicit_not_found_without_pid_requires_one_matching_port() {
+        let reply =
+            r#"{"stoppedCount":0,"results":[{"port":42,"stopped":false,"reason":"not-found"}]}"#;
+        assert_eq!(stop_reply(reply, 42, 7), RemoteStop::Absent);
+        assert_eq!(stop_reply(reply, 43, 7), RemoteStop::Uncertain);
+        for malformed in [
+            r#"{"stoppedCount":0,"results":[{"port":42,"stopped":false,"reason":"not-found"},{"port":42,"stopped":false,"reason":"not-found"}]}"#,
+            r#"{"stoppedCount":1,"results":[{"port":42,"stopped":false,"reason":"not-found"}]}"#,
+            r#"{"stoppedCount":0,"results":[{"port":42,"stopped":true,"reason":"not-found"}]}"#,
+        ] {
+            assert_eq!(stop_reply(malformed, 42, 7), RemoteStop::Uncertain);
+        }
+    }
+
+    #[test]
+    fn a_reaped_leader_and_failed_group_signal_do_not_confirm_helpers() {
+        for result in [
+            Err(SignalError::NotOwned),
+            Err(SignalError::Unavailable),
+            Err(SignalError::Refused),
+            Ok(()),
+        ] {
+            let local = LocalCleanup {
+                leader_reaped: true,
+                group_signals: vec![GroupSignal::observed(result)],
+                helpers: Helpers::Unconfirmed,
+            };
+            assert_eq!(local.helpers, Helpers::Unconfirmed);
+        }
+    }
+}
