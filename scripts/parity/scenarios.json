{
  "$comment": "Parity scenarios. Rows are addressed by key prefix and title, never by seeded session IDs. Targets name controls: a CSS selector or a button's exact text in Electron, an accessible ID in the native client. See scripts/parity/DOCUMENTATION.md.",
  "targets": {
    "prompt-indicator": {
      "electron": { "selector": "nav[aria-label='Prompt navigation'] button[aria-haspopup='listbox']" },
      "native": "prompt-indicator"
    },
    "prompt-list": {
      "electron": { "selector": "nav[aria-label='Prompt navigation'] [role='listbox']" },
      "native": "prompt-list"
    },
    "app-menu": {
      "electron": {
        "selector": "button[aria-label=\"Open OpenChamber menu\"]"
      },
      "native": "app-menu"
    },
    "sidebar-toggle": {
      "electron": {
        "selector": "button[aria-label=\"Open sessions\"]"
      },
      "native": "sidebar-toggle"
    },
    "new-session": {
      "electron": {
        "button": "New session"
      },
      "native": "new-session"
    },
    "source-board": {
      "electron": {
        "selector": "button[aria-label=\"Issues and PRs\"]"
      },
      "native": "source-board"
    },
    "display-mode": {
      "electron": {
        "selector": "button[aria-label=\"Display mode\"]"
      },
      "native": "display-mode"
    },
    "settings": {
      "electron": {
        "selector": "button[aria-label=\"Settings\"]"
      },
      "native": "settings"
    },
    "instance-switcher": {
      "electron": {
        "selector": "button[aria-label^=\"Open instance\"]"
      },
      "native": "instance-switcher"
    },
    "mini-chat": {
      "electron": {
        "selector": "button[aria-label=\"Open a new Mini Chat window\"]"
      },
      "native": "mini-chat"
    },
    "work-status-toggle": {
      "electron": {
        "selector": "button[aria-label=\"Toggle work-status panel\"]"
      },
      "native": "work-status-toggle"
    },
    "window-minimize": {
      "electron": {
        "selector": "button[aria-label=\"Minimize window\"]"
      },
      "native": "window-minimize"
    },
    "window-maximize": {
      "electron": {
        "selector": "button[aria-label=\"Maximize window\"]"
      },
      "native": "window-maximize"
    },
    "window-close": {
      "electron": {
        "selector": "button[aria-label=\"Close window\"]"
      },
      "native": "window-close"
    },
    "work-status": {
      "electron": {
        "selector": "aside[aria-label=\"Work status\"]"
      },
      "native": "work-status"
    },
    "rail-context": {
      "electron": {
        "selector": "nav[aria-label=\"Panel surfaces\"] button"
      },
      "native": "rail-context"
    },
    "rail-configure": {
      "electron": {
        "selector": "button[aria-label=\"Configure panels\"]"
      },
      "native": "rail-configure"
    },
    "startup-title": {
      "electron": {
        "selector": "h1"
      },
      "native": "startup-title"
    },
    "choose-project": {
      "electron": {
        "button": "Choose project"
      },
      "native": "choose-project"
    },
    "composer": {
      "electron": {
        "selector": ".oc-composer-sheen"
      },
      "native": "composer"
    },
    "composer-attach": {
      "electron": {
        "selector": "button[aria-label=\"Add attachment\"]"
      },
      "native": "composer-attach"
    },
    "composer-submit": {
      "electron": {
        "selector": "button[aria-label=\"Send message\"]"
      },
      "native": "composer-submit"
    },
    "starter-explore": {
      "electron": {
        "button": "Explore the codebase"
      },
      "native": "starter-explore"
    },
    "starter-review": {
      "electron": {
        "button": "Review my changes"
      },
      "native": "starter-review"
    },
    "starter-add": {
      "electron": {
        "selector": "button[aria-label=\"Add a starter\"]"
      },
      "native": "starter-add"
    },
    "session-title": {
      "electron": {
        "selector": "header div:has(> .oc-ui-start-align)"
      },
      "native": "session-title"
    },
    "session-actions": {
      "electron": {
        "selector": "button[aria-label=\"Open session actions\"]"
      },
      "native": "session-actions"
    }
  },
  "scenarios": [
    {
      "id": "shell.startup",
      "feature": "shell.startup-view",
      "description": "The window after startup on the seed, once the composer's model and agent and the work status card's context sources have loaded: sidebar, startup view, composer and rails.",
      "steps": [
        {
          "wait": {
            "electron": {
              "expression": "!!document.querySelector('.model-controls__model-label')?.textContent.trim() && !!document.querySelector('.model-controls__agent-label')?.textContent.trim() && [...document.querySelectorAll('aside[aria-label=\"Work status\"] span')].some((span) => span.textContent.trim() === 'Context sources')"
            },
            "native": {
              "elements": [
                "composer-model",
                "composer-agent",
                "work-status-context"
              ]
            },
            "timeout": 30
          }
        },
        {
          "capture": "startup",
          "targets": [
            "app-menu",
            "sidebar-toggle",
            "new-session",
            "source-board",
            "display-mode",
            "settings",
            "instance-switcher",
            "mini-chat",
            "work-status-toggle",
            "window-minimize",
            "window-maximize",
            "window-close",
            "work-status",
            "rail-context",
            "rail-configure",
            "startup-title",
            "choose-project",
            "composer",
            "composer-attach",
            "composer-submit",
            "starter-explore",
            "starter-review",
            "starter-add"
          ]
        }
      ]
    },
    {
      "id": "transcript.prompt-navigation",
      "feature": "transcript.prompt-navigation",
      "description": "The corner indicator opens the prompt list over the transcript.",
      "steps": [
        { "click": { "zone": "activity:work:session:", "title": "parity: long" } },
        { "wait": {
          "electron": { "expression": "!!document.querySelector(\"nav[aria-label='Prompt navigation'] button[aria-haspopup='listbox']\")" },
          "native": { "elements": ["prompt-indicator"] }, "timeout": 30
        } },
        { "clickTarget": "prompt-indicator" },
        { "wait": {
          "electron": { "expression": "!!document.querySelector(\"nav[aria-label='Prompt navigation'] [role='listbox']\")" },
          "native": { "elements": ["prompt-list"] }, "timeout": 30
        } },
        { "capture": "prompt-list", "targets": ["prompt-list", "composer"] }
      ]
    },
    {
      "id": "sessions.works-by-time",
      "feature": "sessions.works-by-time",
      "description": "Saved time grouping lists project works together while hidden In work and Pinned stay hidden.",
      "settings": {
        "sidebarGrouping": "time",
        "sidebarShowWorkSection": false,
        "sidebarShowPinnedSection": false
      },
      "steps": [
        {
          "wait": {
            "electron": { "expression": "!!document.querySelector('[data-sidebar-row-key=\"activity:timeline:header\"]')" },
            "native": { "elements": ["activity:timeline:header"] },
            "timeout": 30
          }
        },
        { "capture": "by-time", "targets": ["composer", "startup-title"] }
      ]
    },
    {
      "id": "sessions.select-pointer",
      "feature": "sessions.select",
      "description": "A pointer click on an In work row selects the session and reveals its transcript.",
      "steps": [
        {
          "click": {
            "zone": "activity:work:session:",
            "title": "parity: long"
          }
        },
        {
          "wait": {
            "electron": {
              "expression": "!!document.querySelector('[data-session-row][aria-current=\"page\"]') && document.querySelectorAll('[data-message-id]').length > 0"
            },
            "native": {
              "marker": "history-shown"
            },
            "timeout": 30
          }
        },
        {
          "capture": "selected",
          "targets": [
            "session-title",
            "session-actions",
            "composer",
            "composer-submit",
            "work-status",
            "rail-context",
            "new-session"
          ]
        }
      ]
    }
  ]
}
